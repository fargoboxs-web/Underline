{
  "name": "underline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace @underline/api",
    "dev:extension": "npm run dev --workspace @underline/extension",
    "demo:start": "bash ./scripts/demo-start.sh",
    "demo:stop": "bash ./scripts/demo-stop.sh",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
